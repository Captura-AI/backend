# API EXTERNAL
API_EXTERNAL_BASE_URL=https://google.com
APP_CORS_ORIGINS=http://localhost:3000,http://localhost:4173

# APP
APP_NAME=NestJS Starter Kit
APP_HOST=0.0.0.0
APP_PORT=1337
APP_ENV=development
APP_TRUST_PROXY=true

# DATABASE
DATABASE_HOST=localhost
DATABASE_NAME=nestjs_starter_kit
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_PORT=5432
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=false

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=24h
JWT_ISSUER=nestjs-starter-kit

# OPENTELEMETRY
OTEL_ENABLED=false
OTEL_METRICS_ENABLED=true
OTEL_EXPORT_INTERVAL=30000
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_LOG_LEVEL=info
OTEL_SERVICE_NAME=
OTEL_SERVICE_VERSION=

# THROTTLE
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# REDIS
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# QUEUE REDIS
QUEUE_REDIS_HOST=localhost
QUEUE_REDIS_PORT=6379
QUEUE_REDIS_PASSWORD=

# MAILER
MAIL_FROM=noreply@template.co
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=

# FONNTE (WhatsApp/SMS OTP — Provider Indonesia, https://fonnte.com)
# Free tier available. OTP_CHANNEL: whatsapp | sms
FONNTE_TOKEN=
OTP_CHANNEL=whatsapp

# WEB APP (frontend) — used for email CTA links (e.g. receipt → library)
WEB_BASE_URL=http://localhost:3000

# MAGIC LINK
MAGIC_LINK_BASE_URL=http://localhost:3000/auth/magic-link/verify

# GOOGLE OAUTH2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:1337/api/authentication/google/callback
AUTH_SUCCESS_REDIRECT_URL=http://localhost:3000/auth/oauth/callback

# APPLE SIGN IN
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Paste private key content (newlines as \n)
APPLE_PRIVATE_KEY=
APPLE_CALLBACK_URL=http://localhost:1337/api/authentication/apple/callback

# MIDTRANS PAYMENT GATEWAY (https://dashboard.sandbox.  midtrans.com)
# Free sandbox — register at https://dashboard.midtrans.com/register
MIDTRANS_MERCHANT_ID=your-merchant-id
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false

# PRICING CONFIG
SERVICE_FEE_RATE=0.05
TAX_RATE=0.11
PAYMENT_EXPIRY_MINUTES=60

# AI SERVICE (Python FastAPI — captura-ai/ai-service)
# Run locally: cd ai-service && uvicorn app.main:app --reload --port 8000
AI_SERVICE_URL=http://localhost:8000
